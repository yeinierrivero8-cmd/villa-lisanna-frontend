# STRIPE CONFIGURATION
# Get your real test keys from: https://dashboard.stripe.com/test/apikeys
# Replace these with your ACTUAL Stripe test keys

STRIPE_PUBLIC_KEY=pk_test_YOUR_ACTUAL_KEY_HERE
STRIPE_SECRET_KEY=sk_test_YOUR_ACTUAL_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_test_YOUR_ACTUAL_KEY_HERE

# SMTP CONFIGURATION (Email)
# Gmail: smtp.gmail.com
# Other providers: check their SMTP settings

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Database
DATABASE_URL=sqlite:///instance/villalisanna.db

# Flask
FLASK_ENV=production
SECRET_KEY=your-secret-key-here

# Admin Panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here
